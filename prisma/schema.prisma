generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  USER
}

model WorkSchedule {
  id                  String   @id @default(uuid()) @db.Char(36)
  name                String   @unique @db.VarChar(100)
  // Duration policy only; no mandatory start/end clock times.
  requiredWorkMinutes Int      @db.UnsignedSmallInt
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now()) @db.DateTime(3)
  updatedAt           DateTime @updatedAt @db.DateTime(3)
  users               User[]

  @@map("workschedule")
}

model User {
  id             String       @id @default(uuid()) @db.Char(36)
  name           String       @db.VarChar(100)
  position       String?      @db.VarChar(100)
  email          String       @unique @db.VarChar(254)
  passwordHash   String       @db.VarChar(60)
  role           Role         @default(USER)
  isActive       Boolean      @default(true)
  workScheduleId String       @db.Char(36)
  workSchedule   WorkSchedule @relation(fields: [workScheduleId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now()) @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @db.DateTime(3)
  auditLogs      AuditLog[]
  attendances    Attendance[]
  overtimeGrants OvertimeAuthorization[]

  @@index([workScheduleId])
  @@index([isActive, role])
  @@index([createdAt, id])
  @@map("user")
}

model Attendance {
  id                  String   @id @default(uuid()) @db.Char(36)
  userId              String   @db.Char(36)
  user                User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  // Calendar date in checkInTimezone, represented as UTC midnight in Prisma.
  workDate            DateTime @db.Date
  requiredWorkMinutes Int      @db.UnsignedSmallInt
  checkInAt           DateTime @db.DateTime(3)
  checkInLatitude     Float
  checkInLongitude    Float
  checkInAccuracy     Float
  checkInAddress      String?  @db.VarChar(500)
  checkInTimezone     String   @db.VarChar(100)
  checkInDescription  String?  @db.VarChar(1000)
  // Null until regular checkout; each event retains its own location/timezone.
  checkOutAt          DateTime? @db.DateTime(3)
  checkOutLatitude    Float?
  checkOutLongitude   Float?
  checkOutAccuracy    Float?
  checkOutAddress     String?  @db.VarChar(500)
  checkOutTimezone    String?  @db.VarChar(100)
  checkOutDescription String?  @db.VarChar(1000)
  dailyReport         DailyReport?
  overtimeAuthorization OvertimeAuthorization?
  createdAt           DateTime @default(now()) @db.DateTime(3)
  updatedAt           DateTime @updatedAt @db.DateTime(3)

  @@unique([userId, workDate])
  @@index([userId, checkOutAt])
  // Global admin work-date range and deterministic list ordering.
  @@index([workDate, checkInAt, id])
  @@map("attendance")
}

model OvertimeAuthorization {
  id           String     @id @default(uuid()) @db.Char(36)
  attendanceId String     @unique @db.Char(36)
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Restrict)
  grantedById  String     @db.Char(36)
  grantedBy    User       @relation(fields: [grantedById], references: [id], onDelete: Restrict)
  grantedAt    DateTime   @db.DateTime(3)
  revokedAt    DateTime?  @db.DateTime(3)
  note         String?    @db.VarChar(1000)
  createdAt    DateTime   @default(now()) @db.DateTime(3)
  updatedAt    DateTime   @updatedAt @db.DateTime(3)
  overtime     Overtime?

  @@index([grantedById])
  @@map("overtimeauthorization")
}

model OvertimePolicy {
  // Application writes always address the company singleton (id 1).
  id             Int      @id @default(1) @db.UnsignedTinyInt
  maxOpenMinutes Int      @default(720) @db.UnsignedSmallInt
  updatedAt      DateTime @updatedAt @db.DateTime(3)
  // Actor and before/after values are recorded in the existing AuditLog.

  @@map("overtimepolicy")
}

model Overtime {
  id                  String   @id @default(uuid()) @db.Char(36)
  authorizationId     String   @unique @db.Char(36)
  authorization       OvertimeAuthorization @relation(fields: [authorizationId], references: [id], onDelete: Restrict)
  // Snapshotted at check-in; future policy edits never change this value.
  maxOpenMinutes      Int      @default(720) @db.UnsignedSmallInt
  checkInAt           DateTime @db.DateTime(3)
  checkInLatitude     Float
  checkInLongitude    Float
  checkInAccuracy     Float
  checkInAddress      String?  @db.VarChar(500)
  checkInTimezone     String   @db.VarChar(100)
  checkInDescription  String   @db.VarChar(1000)
  checkInPhotoPath    String   @db.VarChar(500)
  checkOutAt          DateTime? @db.DateTime(3)
  checkOutLatitude    Float?
  checkOutLongitude   Float?
  checkOutAccuracy    Float?
  checkOutAddress     String?  @db.VarChar(500)
  checkOutTimezone    String?  @db.VarChar(100)
  checkOutDescription String?  @db.VarChar(1000)
  checkOutPhotoPath   String?  @db.VarChar(500)
  createdAt           DateTime @default(now()) @db.DateTime(3)
  updatedAt           DateTime @updatedAt @db.DateTime(3)

  @@index([checkOutAt])
  @@map("overtime")
}

model DailyReport {
  id           String     @id @default(uuid()) @db.Char(36)
  attendanceId String     @unique @db.Char(36)
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Restrict)
  content      String     @db.Text
  createdAt    DateTime   @default(now()) @db.DateTime(3)
  updatedAt    DateTime   @updatedAt @db.DateTime(3)

  @@map("dailyreport")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Char(36)
  // Null means a trusted system/bootstrap operation, not an authenticated user.
  actorId    String?  @db.Char(36)
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(100)
  entityId   String   @db.Char(36)
  metadata   Json?
  createdAt  DateTime @default(now()) @db.DateTime(3)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@map("auditlog")
}
