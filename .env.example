# Database
DATABASE_URL="mysql://etime:password@localhost:3306/etime"

# Initial Admin Seed (Phase 2)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me"
SEED_ADMIN_NAME="ETime Administrator"

# Authentication (Phase 3)
NEXTAUTH_SECRET="replace-with-a-secure-secret"
NEXTAUTH_URL="http://localhost:3000"

# Storage (Phase 9)
STORAGE_ROOT="./storage"
# Optional server-only reverse geocoding. Missing key or provider failure leaves address null.
# Configure a Geoapify project key in deployment secrets; never use NEXT_PUBLIC_ here.
GEOAPIFY_API_KEY=""
