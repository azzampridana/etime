{
  "name": "etime",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "node --conditions=react-server --import tsx prisma/seed.ts",
    "db:migrate:dev": "prisma migrate dev",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "db:verify": "node --conditions=react-server --import tsx prisma/verify.ts",
    "test:auth:integration": "node --conditions=react-server --import tsx tests/auth.integration.ts",
    "test:attendance:integration": "node --conditions=react-server --import tsx tests/attendance.integration.ts",
    "test:checkout:integration": "node --conditions=react-server --import tsx tests/checkout.integration.ts",
    "test:admin:integration": "node --conditions=react-server --import tsx tests/admin.integration.ts",
    "test:overtime-authorization:integration": "node --conditions=react-server --import tsx tests/overtime-authorization.integration.ts",
    "test:overtime:integration": "node --conditions=react-server --import tsx tests/overtime.integration.ts",
    "test:admin-overtime:integration": "node --conditions=react-server --import tsx tests/admin-overtime.integration.ts",
    "test:report:integration": "node --conditions=react-server --import tsx tests/report.integration.ts",
    "test:domain-adjustment:integration": "node --conditions=react-server --import tsx tests/domain-adjustment.integration.ts"
  },
  "dependencies": {
    "@next/env": "^16.3.5",
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "chart.js": "4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.23.0",
    "mariadb": "^3.5.3",
    "next": "16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "^7.8.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}